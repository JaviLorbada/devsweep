# The product's names and version, in one place. Scripts/package_app.sh, the
# release workflow and the Homebrew files read this; ProductInfo.swift holds
# the same names for the code, and a test keeps the two in step.
PRODUCT_NAME=DevSweep
CLI_NAME=devsweep
BUNDLE_ID=com.javilorbada.devsweep
MARKETING_VERSION=0.1.0
BUILD_NUMBER=1
