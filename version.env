# The product's names and version, in one place. Scripts/package_app.sh, the
# release workflow and the Homebrew files read this; ProductInfo.swift holds
# the same names for the code, and a test keeps the two in step.
PRODUCT_NAME=DevSweep
CLI_NAME=devsweep
BUNDLE_ID=com.javilorbada.devsweep
MARKETING_VERSION=0.6.0
# The build number is the date and time the release was cut, in UTC:
# `date -u +%Y%m%d%H%M`.
BUILD_NUMBER=202611141450
# Where the app looks for updates, the appcast the release workflow attaches
# to each release, and the public half of the key that signs them: Sparkle's
# SUFeedURL and SUPublicEDKey in the released app's Info.plist. The private
# half is the release environment's SPARKLE_PRIVATE_KEY.
UPDATE_FEED_URL=https://github.com/JaviLorbada/devsweep/releases/latest/download/appcast.xml
UPDATE_PUBLIC_KEY=IDfcBfy+0qB0PZsb//SYKrO51jdD1rmCk4PXFiOf0eg=
