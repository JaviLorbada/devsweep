# SwiftFormat configuration. Run with Scripts/lint.sh format; CI checks it
# with Scripts/lint.sh lint.

# Swift 6 strict concurrency: explicit self stays, it is intentional.
--swiftversion 6.2
--self insert
--importgrouping testable-bottom
--extensionacl on-declarations

# Indentation
--indent 4
--indentcase false
--ifdef no-indent

# Line breaks and whitespace
--linebreaks lf
--maxwidth 120
--trimwhitespace always
--emptybraces no-space
--ranges no-space
--nospaceoperators ...,..<
--someAny true

# Wrapping
--wraparguments before-first
--wrapparameters before-first
--wrapcollections before-first
--closingparen same-line
# An if or guard body goes on lines of its own, as does the work a Task or
# MainActor.assumeIsolated runs. A closure that only returns a value, such
# as a Binding's get or a map, stays on one line.
--enable wrapGuardStatementBodies,wrapClosureBodies
--wrap-closure-bodies Task,Task.detached,MainActor.assumeIsolated

# Rules left off
--disable redundantSendable # Keep explicit concurrency contracts visible
--disable wrapFunctionBodies # Keep one-line computed properties and test helpers
--disable swiftTestingTestCaseNames,redundantSwiftTestingSuite # Test names are backticked sentences

# Other
--stripunusedargs closure-only
--header ignore
--allman false

--exclude .build,.swiftpm,DerivedData,build,xcuserdata
